  <link name="world" />
  <joint name="joint_w" type="fixed">
    <parent link="world" />
    <child link="base_link" />
  </joint>
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="resources/denso_robot_descriptions/robots/vs060/meshes/base_link.dae" scale="1 1 1" />
