  <!-- joint list -->
  <!-- Joints are specified such that the driver rotates the joints about the positive Z axis. -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link" />
    <child link="link_1" />
    <origin rpy="0 0 0" xyz="0 0 0.505" />
    <axis xyz="0 0 1" />
    <limit effort="3087" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.6651914291880923" />
  </joint>
