      <geometry>
        <mesh filename="resources/rokae_description/meshes/xMateCR7/visual/xMateCR7_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <material name="white"/>
    </visual>
    <inertial>
      <mass value="3.44074938"/>
