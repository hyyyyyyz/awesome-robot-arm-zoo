<!-- Resource paths are relative to this model entry. -->
<robot name="MICO-Core">
  <material name="flexiv_black">
    <color rgba="0.22 0.22 0.22 1"/>
  </material>
  <!--
    MICO-Core: fixed torso (no actuated torso joints) with two Enlight-L arms.
    Arm joints: left_<robot_sn>_joint1..7, right_<robot_sn>_joint1..7.
    An empty robot_sn drops the separating underscore, e.g. 'torso_joint1', 'left_joint1'.
  -->
  <!-- World link and fixed joint to torso base -->
  <link name="world"/>
  <joint name="torso_world_joint" type="fixed">
    <parent link="world"/>
    <child link="torso_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- Torso: MICO-Core base_link (fixed, no revolute joints) -->
  <link name="torso_base_link">
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0027794 -0.00019221 0.22614"/>
      <mass value="23.116"/>
      <inertia ixx="0.27032" ixy="-0.00021807" ixz="0.00091154" iyy="0.13627" iyz="-0.00034551" izz="0.22713"/>
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="resources/flexiv_description/meshes/MICO-Core/visual/Core-link.obj"/>
      </geometry>
    </visual>
    <collision name="convex_mesh">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="resources/flexiv_description/meshes/MICO-Core/collision/Core-link.stl"/>
      </geometry>
    </collision>
  </link>
  <!-- Torso flange links (massless) -->
  <link name="torso_left_flange">
    <inertial>
      <mass value="0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
