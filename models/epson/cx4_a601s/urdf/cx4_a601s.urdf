  <joint name="j2_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0.06 0.16" />
    <parent link="j1_link" />
    <child link="j2_link" />
    <axis xyz="1 0 0" />
    <limit effort="0.0" lower="-2.70526050703877" upper="1.16937100940686" velocity="7.85276878602804" />
