<?xml version='1.0' encoding='utf-8'?>
<robot name="EPSON_C8-C1401C">
  <!-- Resource filenames are local paths relative to this entry. -->
  <ros2_control name="EPSON_ROBOT" type="system">
    <hardware>
      <plugin>epson_robot_control/EpsonRobotHwIf</plugin>
      <param name="controller_ip" />
      <param name="controller_port" />
      <param name="client_ip" />
      <param name="client_builtinmsg_port" />
      <param name="client_userdata_port" />
      <param name="send_format" />
      <param name="recv_format" />
      <param name="rb_model">C8-C1401C</param>
      <param name="weight" />
      <param name="inertia" />
      <param name="eccentricity" />
      <param name="security" />
      <param name="ca_cert" />
      <param name="client_cert" />
      <param name="key" />
      <param name="governance" />
      <param name="permissions" />
      <param name="password" />
      <param name="buffer_size" />
      <param name="namespace" />
      <param name="log_level" />
    </hardware>
    <joint name="j1_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j2_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j3_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j4_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j5_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j6_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
  </ros2_control>
  <!-- world link -->
  <link name="world" />
  <!-- base link -->
  <link name="base_link">
    <visual>
      <origin rpy="1.57 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/C8-C1401C/meshes/base.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="1.57 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/C8-C1401C/meshes/base.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="world" />
    <child link="base_link" />
  </joint>
  <!--link 1-->
  <link name="j1_link">
    <visual>
      <origin rpy="1.57 0 0" xyz="0 0 -0.269" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/C8-C1401C/meshes/j1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="1.57 0 0" xyz="0 0 -0.269" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/C8-C1401C/meshes/j1.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <transmission name="j1_joint_Trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="j1_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="j1_joint_Motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <joint name="j1_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.269" />
    <parent link="base_link" />
    <child link="j1_link" />
    <axis xyz="0 0 1" />
    <limit effort="0.0" lower="-4.18879680766231" upper="4.18879680766231" velocity="3.48885399302218" />
  </joint>
