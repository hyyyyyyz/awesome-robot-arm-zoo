<?xml version='1.0' encoding='utf-8'?>
<robot name="EPSON_GX4-C251S">
  <!-- Resource filenames are local paths relative to this entry. -->
  <ros2_control name="EPSON_ROBOT_ROS" type="system">
    <hardware>
      <plugin>epson_robot_control/EpsonRobotHwIf</plugin>
      <param name="controller_ip" />
      <param name="controller_port" />
      <param name="client_ip" />
      <param name="client_builtinmsg_port" />
      <param name="client_userdata_port" />
      <param name="send_format" />
      <param name="recv_format" />
      <param name="rb_model">GX4-C251S</param>
      <param name="weight" />
      <param name="inertia" />
      <param name="eccentricity" />
      <param name="security" />
      <param name="ca_cert" />
      <param name="client_cert" />
      <param name="key" />
      <param name="governance" />
      <param name="permissions" />
      <param name="password" />
      <param name="buffer_size" />
      <param name="namespace" />
      <param name="log_level" />
    </hardware>
    <joint name="j1_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j2_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j3_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
    <joint name="j4_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
  </ros2_control>
  <!-- world link -->
  <link name="world" />
  <!-- base link -->
  <link name="base_link">
    <visual>
      <origin rpy="1.57 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/GX4-C251S/meshes/base.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="1.57 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/GX4-C251S/meshes/base.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 -0.124" />
    <parent link="world" />
    <child link="base_link" />
  </joint>
  <!--link 1-->
  <link name="j1_link">
    <visual>
      <origin rpy="1.57 0 -1.57" xyz="0 0 -0.156" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/GX4-C251S/meshes/j1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="1.57 0 -1.57" xyz="0 0 -0.156" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/GX4-C251S/meshes/j1.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <transmission name="j1_joint_Trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="j1_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="j1_joint_Motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <joint name="j1_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.156" />
    <parent link="base_link" />
    <child link="j1_link" />
    <axis xyz="0 0 1" />
    <limit effort="0.0" lower="-0.872664892313273" upper="4.01425754590306" velocity="7.85398163397448" />
  </joint>
  <!--link 2-->
  <link name="j2_link">
    <visual>
      <origin rpy="1.57 0 -1.57" xyz="-0.124 0 -0.166" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/GX4-C251S/meshes/j2.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="1.57 0 -1.57" xyz="-0.124 0 -0.166" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/GX4-C251S/meshes/j2.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <transmission name="j2_joint_Trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="j2_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="j2_joint_Motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <joint name="j2_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.124 0 0.01" />
    <parent link="j1_link" />
    <child link="j2_link" />
    <axis xyz="0 0 1" />
    <limit effort="0.0" lower="-2.46091456489133" upper="2.46091456489133" velocity="12.5663706143591" />
  </joint>
  <!--link 3-->
  <link name="j3_link">
    <visual>
      <origin rpy="1.57 0 0" xyz="0 -0.25 -0.124" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/GX4-C251S/meshes/j3.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="">
        <color rgba="0.75 0.75 0.75 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="1.57 0 0" xyz="0 -0.25 -0.124" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/GX4-C251S/meshes/j3.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <transmission name="j3_joint_Trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="j3_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="j3_joint_Motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <joint name="j3_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0.126 0 -0.042" />
    <parent link="j2_link" />
    <child link="j3_link" />
    <axis xyz="0 0 1" />
    <limit effort="0.0" lower="-0.150000029296875" upper="0" velocity="1.152" />
  </joint>
  <!--link 4-->
  <link name="j4_link">
    <visual>
      <origin rpy="1.57 0 0" xyz="0 -0.25 -0.124" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/GX4-C251S/meshes/j4.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="">
        <color rgba="0.75 0.75 0.75 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="1.57 0 0" xyz="0 -0.25 -0.124" />
      <geometry>
        <mesh filename="resources/epson_robot_description/models/GX4-C251S/meshes/j4.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <transmission name="j4_joint_Trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="j4_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="j4_joint_Motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <joint name="j4_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="j3_link" />
    <child link="j4_link" />
    <axis xyz="0 0 1" />
    <limit effort="0.0" lower="-6.28318530717958" upper="6.28318530717958" velocity="55.1156600636707" />
  </joint>
</robot>